# ─────────────────────────────────────────────────────────────────────────────
# Cloud Ransomware Kill-Switch — Environment Configuration
# Copy this to .env and fill in real values before running infra/setup.py
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# AWS region for all provisioned resources
AWS_REGION=us-east-1

# Account ID — populated automatically by infra/setup.py, but set manually if needed
AWS_ACCOUNT_ID=

# S3 test bucket (target of attacker simulation)
# setup.py will create this bucket; name must be globally unique
TEST_BUCKET_NAME=killswitch-test-

# S3 bucket for CloudTrail log delivery (created by setup.py)
CLOUDTRAIL_LOG_BUCKET=killswitch-cloudtrail-

# CloudTrail trail name
CLOUDTRAIL_TRAIL_NAME=killswitch-trail

# DynamoDB table for per-principal EWMA baseline state
BASELINE_TABLE=killswitch-baselines

# DynamoDB table for remediation audit log
FINDINGS_TABLE=killswitch-findings

# Lambda function name
LAMBDA_FUNCTION_NAME=killswitch-detector

# IAM role for Lambda execution
LAMBDA_ROLE_NAME=killswitch-lambda-role

# SNS topic ARN for ALERT-tier notifications (populated by setup.py)
SNS_ALERT_TOPIC_ARN=

# EventBridge rule name
EVENTBRIDGE_RULE_NAME=killswitch-s3-events

# ─── Attacker Simulator Credentials ──────────────────────────────────────────
# These are the credentials for the THROWAWAY test principal.
# The attacker.py script uses these — NOT your admin credentials.
# setup.py creates this user and prints the keys; paste them here.
ATTACKER_ACCESS_KEY_ID=
ATTACKER_SECRET_ACCESS_KEY=
ATTACKER_IAM_USERNAME=killswitch-attacker

# ─── Neo4j (Phase 3) ─────────────────────────────────────────────────────────
# Local Docker (default): bolt://localhost:7687
# Aura free tier: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=killswitch-local-dev

# ─── Detector Tuning Parameters ───────────────────────────────────────────────
# These are exposed as env vars so you can tune without code changes.
# See detector/rate_monitor.py for algorithm documentation.
EWMA_ALPHA=0.3              # EWMA learning rate (0 < α < 1; lower = slower adaptation)
Z_SCORE_THRESHOLD=4.0       # Standard deviations above baseline to flag (>4σ)
RATE_MULTIPLIER_THRESHOLD=10.0  # Also flag if current rate > N× baseline (catches new principals)
WINDOW_SECONDS=60           # Rolling window size in seconds
MIN_OBSERVATIONS=5          # Minimum completed windows before flagging (avoids cold-start FP)
